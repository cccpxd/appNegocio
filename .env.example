# Copia este archivo como .env para trabajar en local.
# En Vercel estas variables se ponen en Project Settings → Environment Variables.

# Obligatoria. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Obligatoria en producción. Cadena del pooler de Neon (la que termina en -pooler).
# Si la omites, la app arranca pero /procesar responde 501.
DATABASE_URL=

# Obligatoria para el cron. Vercel manda "Authorization: Bearer <esto>"
# automáticamente cuando la variable se llama CRON_SECRET.
CRON_SECRET=

# Opcionales (los valores por defecto ya sirven).
# SERVICIO_IA=standard        # standard | flex
# TIEMPO_IA_MS=60000
